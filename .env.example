# Скопируйте в .env и заполните своими значениями.

# ─── Supabase (авторизация + журнал сигналов) ───────────────────────
# Из Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# "anon public" ключ — публичный, безопасно отдавать клиенту
SUPABASE_ANON_KEY=your-anon-public-key
# "service_role" ключ — ПРИВАТНЫЙ, нужен серверу для записи в journal и чтения подписчиков.
# Никогда не отдавайте его клиенту.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Telegram (доставка сигналов в лс) ──────────────────────────────
# Создайте бота у @BotFather, скопируйте токен сюда.
# Если не задан — доставка в Telegram отключена, но сайт и журнал работают.
TG_BOT_TOKEN=

# ─── Платформа сигналов ─────────────────────────────────────────────
# Таймфрейм стратегии (1m, 5m, 15m, 1h, 4h, 1d)
SIGNAL_INTERVAL=15m
# Пары, по которым крутится движок (через запятую)
SIGNAL_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,DOTUSDT,ATOMUSDT,LTCUSDT

# ─── Прочее ─────────────────────────────────────────────────────────
# Порт сервера (по умолчанию 3000)
# PORT=3000
# Интервал обновления внутреннего котировочного движка на лендинге (мс)
# TICK_MS=1000
