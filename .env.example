# Скопируйте в .env и заполните своими значениями.

# Из Supabase Dashboard → Settings → API
# "Project URL"
SUPABASE_URL=https://your-project.supabase.co
# "Project API keys" → anon public (это публичный ключ, его можно отдавать клиенту)
SUPABASE_ANON_KEY=your-anon-public-key

# Порт сервера (по умолчанию 3000)
# PORT=3000

# Интервал обновления внутреннего котировочного движка (мс), используемого на лендинге
# TICK_MS=1000
